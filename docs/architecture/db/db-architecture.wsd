@startuml

entity flagship_event_versions {
    * id : UUID [PK]
    --
    version_name : VARCHAR(50)
    slug : VARCHAR(50)
    version_number : DECIMAL(3,1)
    status : VARCHAR(20)
    start_date : DATE
    end_date : DATE
    is_current : BOOLEAN
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

entity asset_library {
  * id : INTEGER [PK]
  --
  flagship_event_version_id : UUID [FK]
  source_table : ENUM(hero_sections, gallery_sections)
  source_table_id : UUID [FK]
  max_image_upload : INTEGER
  extra_options : JSONB
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity assets {
  * id : INTEGER [PK]
  --
  asset_library_id : INTEGER [FK]
  image_path : TEXT
  image_url : TEXT
  display_order : INTEGER
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
  deleted_at : TIMESTAMP
}

entity hero_sections {
    * id : UUID [PK]
    --
    flagship_event_version_id : UUID [FK]
    heading : TEXT
    paragraph : TEXT
    extraOptions : JSONB
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

entity achievement_metrics {
    * id : UUID [PK]
    --
    flagship_event_version_id : UUID [FK]
    total_participants : INTEGER
    social_media_reach : INTEGER
    collaborations : INTEGER
    additional_metrics : JSONB
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

entity about_sections {
    * id : UUID [PK]
    --
    flagship_event_version_id : UUID [FK]
    title : VARCHAR(255)
    content : TEXT
    image_url : TEXT
    image_path : TEXT
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

entity speakers {
    * id : UUID [PK]
    --
    flagship_event_version_id : UUID [FK]
    name : VARCHAR(255)
    job_title : VARCHAR(255)
    speaker_type : ENUM(panelist, judge, speaker)
    position : VARCHAR(255)
    social_links : JSONB
    image_url : TEXT
    image_path : TEXT
    display_order : INTEGER
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

entity events {
    * id : UUID [PK]
    --
    flagship_event_version_id : UUID [FK]
    title : VARCHAR(255)
    description : TEXT
    location : VARCHAR(255)
    event_date : DATE
    days : INT
    start_time : TIME
    end_time : TIME
    category : VARCHAR(50)
    seats_available : INTEGER
    seats_registered : INTEGER
    image_url : TEXT
    image_path : TEXT
    display_order : INTEGER
    fee_type : ENUM(paid, free)
    fee : INTEGER
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

entity event_speakers {
    * id : UUID [PK]
    --
    event_id : UUID [FK]
    speaker_id : UUID [FK]
    created_at : TIMESTAMP
}

entity event_registrations {
    * id : UUID [PK]
    --
    event_id : UUID [FK]
    user_name : VARCHAR(255)
    contact_number : VARCHAR(20)
    email : VARCHAR(255)
    is_student : BOOLEAN
    year : VARCHAR(20)
    education_level : VARCHAR(50)
    faculty : VARCHAR(255)
    registration_date : TIMESTAMP
    status : VARCHAR(20)
    created_at : TIMESTAMP
}

entity sponsors {
    * id : UUID [PK]
    --
    flagship_event_version_id : UUID [FK]
    name : VARCHAR(255)
    tier : VARCHAR(50)
    logo_url : TEXT
    website_url : TEXT
    display_order : INTEGER
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

entity gallery_sections {
    * id : UUID [PK]
    --
    flagship_event_version_id : UUID [FK]
    title : VARCHAR(255)
    description : TEXT
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

entity team_members {
    * id : UUID [PK]
    --
    flagship_event_version_id : UUID [FK]
    name : VARCHAR(255)
    category : VARCHAR(50)
    designation : VARCHAR(100)
    role : VARCHAR(100)
    image_url : TEXT
    image_path : TEXT
    social_links : JSONB
    display_order : INTEGER
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

entity version_settings {
    * id : UUID [PK]
    --
    flagship_event_version_id : UUID [FK]
    primary_color : VARCHAR(7)
    secondary_color : VARCHAR(7)
    background_color : VARCHAR(7)
    text_color : VARCHAR(7)
    accent_color : VARCHAR(7)
    font_family : VARCHAR(100)
    heading_font : VARCHAR(100)
    body_font : VARCHAR(100)
    theme_mode : VARCHAR(20)
    border_radius : VARCHAR(10)
    button_style : JSONB
    custom_css : TEXT
    additional_settings : JSONB
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

entity audit_logs {
    * id : UUID [PK]
    --
    flagship_event_version_id : UUID [FK]
    logType : ENUM(info, error)
    userId : UUID
    logActionType : ENUM(login, logout, create, update, delete, view)
    message : VARCHAR(255)
    scope : ENUM(events, event_speakers, sponsors, event_registrations, hero_sections, achievement_metrics, speakers, gallery_items, team_members, version_settings, about_sections)
    ipAddress : VARCHAR(50)
}

' RELATIONSHIPS
flagship_event_versions ||--o{ hero_sections
flagship_event_versions ||--o{ achievement_metrics
flagship_event_versions ||--o{ about_sections
flagship_event_versions ||--o{ speakers
flagship_event_versions ||--o{ events
flagship_event_versions ||--o{ sponsors
flagship_event_versions ||--o{ gallery_sections
flagship_event_versions ||--o{ team_members
flagship_event_versions ||--o{ version_settings
flagship_event_versions ||--o{ audit_logs
flagship_event_versions ||--o{ asset_library

events ||--o{ event_speakers
speakers ||--o{ event_speakers
events ||--o{ event_registrations

' Asset Library Relationships
hero_sections ||--o{ asset_library
gallery_sections ||--o{ asset_library
asset_library ||--o{ assets

@enduml