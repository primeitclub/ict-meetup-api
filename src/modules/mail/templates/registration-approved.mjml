<mjml>
  <mj-head>
    <mj-title>Registration Confirmed — ICT Meetup</mj-title>
    <mj-preview>Your registration has been approved. See you at the event!</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="15px" line-height="1.7" color="#1e293b" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#0f172a">

    <!-- Header -->
    <mj-section background-color="#0f172a" padding="40px 40px 28px">
      <mj-column>
        {{logoSection}}
        <mj-text align="center" color="#f1f5f9" font-size="20px" font-weight="bold" letter-spacing="1px" padding-top="12px">
          {{heroTitle}}
        </mj-text>
        {{heroDescriptionSection}}
      </mj-column>
    </mj-section>

    <!-- Status banner -->
    <mj-section background-color="#065f46" padding="13px 40px">
      <mj-column>
        <mj-text align="center" color="#d1fae5" font-size="11px" font-weight="bold" letter-spacing="2px" padding="0">
          REGISTRATION CONFIRMED
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Body -->
    <mj-section background-color="#ffffff" padding="40px 40px 16px">
      <mj-column>
        <mj-text font-size="22px" font-weight="bold" color="#0f172a" line-height="1.3" padding-bottom="8px">
          Registration Confirmed
        </mj-text>
        <mj-text>
          Hi <strong>{{username}}</strong>,
        </mj-text>
        <mj-text>
          Your registration for <strong>{{eventTitle}}</strong> has been approved. You are officially on the list.
        </mj-text>
        <mj-text color="#64748b" font-size="14px" padding-bottom="8px">
          Keep an eye on your inbox for further updates about the event. We look forward to seeing you there.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Contact section -->
    <mj-section background-color="#f8fafc" padding="20px 40px">
      <mj-column>
        <mj-text font-size="13px" color="#0f172a" font-weight="bold" padding-bottom="0">
          Prime IT Club
        </mj-text>
        {{clubContactBlock}}
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#0f172a" padding="28px 40px 24px">
      <mj-column>
        {{socialLinksBlock}}
        <mj-text align="center" font-size="12px" color="#475569" padding-top="12px">
          &copy; 2026 ICT Meetup &mdash; Prime IT Club
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
